{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foom.local/schemas/forge-1-draft.json",
  "title": "Proposed forge kind v1 (#520); not a runtime contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "forge"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "badge": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,4}$"
    },
    "executables": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "minItems": 1,
          "maxItems": 8
        },
        "namespace": {
          "enum": [
            "pair",
            "nested"
          ]
        },
        "case": {
          "enum": [
            "ascii-insensitive",
            "exact"
          ]
        }
      },
      "required": [
        "hosts",
        "namespace",
        "case"
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "$ref": "#/$defs/argv"
        },
        "successExitCodes": {
          "type": "array",
          "items": {
            "const": 0
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "argv",
        "successExitCodes"
      ]
    },
    "environment": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 128
      }
    },
    "minimumIntervalSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lookupByBranch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "open": {
              "$ref": "#/$defs/command"
            },
            "all": {
              "$ref": "#/$defs/command"
            }
          },
          "required": [
            "open",
            "all"
          ]
        },
        "resolveNumber": {
          "$ref": "#/$defs/command"
        },
        "refresh": {
          "$ref": "#/$defs/command"
        },
        "display": {
          "$ref": "#/$defs/command"
        },
        "batchStatus": {
          "$ref": "#/$defs/batch"
        }
      },
      "required": [
        "lookupByBranch",
        "resolveNumber",
        "refresh"
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number": {
          "$ref": "#/$defs/path"
        },
        "branch": {
          "$ref": "#/$defs/path"
        },
        "headSha": {
          "$ref": "#/$defs/path"
        },
        "state": {
          "$ref": "#/$defs/path"
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "enum": [
              "OPEN",
              "CLOSED",
              "MERGED"
            ]
          }
        },
        "title": {
          "$ref": "#/$defs/path"
        },
        "webUrl": {
          "$ref": "#/$defs/path"
        },
        "projects": {
          "$ref": "#/$defs/projects"
        }
      },
      "required": [
        "number",
        "branch",
        "headSha",
        "state",
        "states",
        "projects"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "meaning": {
          "enum": [
            "required",
            "head-pipeline",
            "commit-status"
          ]
        },
        "primary": {
          "$ref": "#/$defs/plan"
        },
        "fallback": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "meaning",
        "primary"
      ]
    }
  },
  "required": [
    "kind",
    "version",
    "id",
    "name",
    "badge",
    "executables",
    "remote",
    "auth",
    "operations",
    "mapping",
    "checks"
  ],
  "$defs": {
    "path": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          }
        ]
      },
      "minItems": 0,
      "maxItems": 12
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot": {
          "enum": [
            "branch",
            "number",
            "project",
            "host",
            "nodeId",
            "query",
            "branches"
          ]
        },
        "encoding": {
          "enum": [
            "literal",
            "percent-component",
            "json"
          ]
        }
      },
      "required": [
        "slot",
        "encoding"
      ]
    },
    "arg": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "$ref": "#/$defs/slot"
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 16
            }
          },
          "required": [
            "parts"
          ]
        }
      ]
    },
    "argv": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/arg"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "$ref": "#/$defs/argv"
        },
        "jsonExitCodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 1,
          "maxItems": 4
        },
        "bindNodeId": {
          "$ref": "#/$defs/path"
        },
        "emptyDiagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exitCode": {
                "const": 1
              },
              "prefix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "suffix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "exitCode",
              "prefix",
              "suffix"
            ]
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "required": [
        "argv",
        "jsonExitCodes"
      ]
    },
    "guard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "absent": {
              "const": true
            }
          },
          "required": [
            "path",
            "absent"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "binding": {
              "enum": [
                "headSha",
                "number"
              ]
            }
          },
          "required": [
            "path",
            "binding"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "path",
            "length"
          ]
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "equals": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "path",
            "equals"
          ]
        },
        "status": {
          "$ref": "#/$defs/path"
        },
        "completed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "unfinished": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 16
        },
        "value": {
          "$ref": "#/$defs/path"
        },
        "table": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "enum": [
              "pending",
              "success",
              "failure",
              "none",
              "unknown"
            ]
          }
        }
      },
      "required": [
        "value",
        "table"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guard"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "nullAt": {
          "$ref": "#/$defs/path"
        },
        "rows": {
          "$ref": "#/$defs/path"
        },
        "shape": {
          "enum": [
            "array",
            "object"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "pageComplete": {
          "$ref": "#/$defs/path"
        },
        "required": {
          "$ref": "#/$defs/path"
        },
        "rowGuards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guard"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "rows",
        "shape",
        "limit",
        "variants"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "result": {
          "$ref": "#/$defs/result"
        }
      },
      "required": [
        "commands",
        "result"
      ]
    },
    "projects": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "owner-and-cross-flag"
            },
            "owner": {
              "$ref": "#/$defs/path"
            },
            "crossProject": {
              "$ref": "#/$defs/path"
            },
            "sourceName": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "mode",
            "owner",
            "crossProject",
            "sourceName"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "numeric-project-ids"
            },
            "source": {
              "$ref": "#/$defs/path"
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "context": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "mode",
            "source",
            "target",
            "context"
          ]
        }
      ]
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "rows": {
          "$ref": "#/$defs/path"
        },
        "pageComplete": {
          "$ref": "#/$defs/path"
        },
        "maxBranches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "command",
        "rows",
        "pageComplete",
        "maxBranches"
      ]
    }
  }
}
