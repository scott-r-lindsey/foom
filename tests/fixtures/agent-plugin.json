{
  "kind": "agent",
  "version": 2,
  "id": "foom-test-agent",
  "name": "Fixture agent",
  "badge": "FT",
  "executables": ["foom-test-agent"],
  "discovery": {
    "facts": [
      {
        "id": "hookSupport",
        "helpTokens": ["--observer"]
      },
      {
        "id": "mcpSupport",
        "helpTokens": ["--mcp"]
      }
    ]
  },
  "launch": {
    "order": [
      "defaults",
      "arguments",
      "resume",
      "display",
      "guidance",
      "hooks",
      "mcp",
      "tools",
      "prompt"
    ],
    "arguments": {
      "arguments": ["--literal", "$(must-not-execute)"]
    },
    "prompt": {
      "arguments": ["--prompt", "{prompt}"]
    },
    "resume": {
      "arguments": ["--resume", "{conversationId}"]
    }
  },
  "bypassArguments": [
    {
      "flag": "--yolo",
      "forms": ["exact"]
    }
  ],
  "attention": {
    "minimumEngineVersion": 1,
    "rules": [
      {
        "id": "working",
        "state": "working",
        "priority": 100,
        "region": "title",
        "match": {
          "contains": ["Fixture working"],
          "regex": ["^Fixture"]
        },
        "reason": "Fixture is working"
      },
      {
        "id": "permission",
        "state": "blocked",
        "priority": 200,
        "region": "bottom",
        "lines": 2,
        "match": {
          "contains": ["Approve fixture?"]
        },
        "not": [
          {
            "contains": ["approved"]
          }
        ],
        "reason": "Fixture requests permission",
        "comment": "Synthetic permission form"
      }
    ]
  },
  "reservedArguments": [],
  "bypassEnvironment": [],
  "resumePaste": [],
  "conversation": {
    "resumePin": "first-event",
    "restoreControl": false
  },
  "execution": {
    "completion": "observed",
    "completionChannels": ["lifecycle"]
  },
  "hooks": {
    "channels": [
      {
        "id": "lifecycle",
        "when": {
          "all": [
            {
              "field": "hooksEnabled",
              "op": "eq",
              "value": true
            },
            {
              "field": "hookSupport",
              "op": "eq",
              "value": true
            }
          ]
        },
        "observer": {
          "transport": "argv-last",
          "placement": "launch",
          "version": 1,
          "response": "silent",
          "delivery": "foreground",
          "timeoutMs": 3000
        },
        "arguments": ["--observer", "{observerArgv:lifecycle:json}"],
        "mapping": {
          "session": {
            "source": "payload",
            "path": ["session"]
          },
          "event": {
            "source": "payload",
            "path": ["event"]
          },
          "cases": [
            {
              "id": "start",
              "event": "start",
              "action": "working"
            },
            {
              "id": "stop",
              "event": "stop",
              "action": "classify"
            },
            {
              "id": "permission",
              "event": "permission",
              "action": "needs_input"
            },
            {
              "id": "ready",
              "event": "ready",
              "action": "ready"
            },
            {
              "id": "failed",
              "event": "failed",
              "action": "failed"
            }
          ]
        }
      }
    ]
  }
}
