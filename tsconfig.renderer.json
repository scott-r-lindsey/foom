{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx"
  },
  "include": [
    "src/manual/**/*.ts",
    "src/renderer/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/**/*.tsx"
  ]
}
