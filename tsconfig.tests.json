{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true
  },
  "include": ["tests/**/*.ts", "vitest.config.mts", "src/renderer/global.d.ts", "scripts/*.mjs"]
}
