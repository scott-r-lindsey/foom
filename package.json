{
  "name": "foom",
  "productName": "Foom",
  "version": "0.1.0",
  "description": "A minimal Electron terminal.",
  "private": true,
  "license": "Apache-2.0",
  "main": "build/main/main.js",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start:samples": "pnpm run build --samples && node scripts/start-samples.mjs",
    "start": "pnpm run build && electron-forge start",
    "start:hosts": "node scripts/start-hosts.mjs",
    "start:fresh": "pnpm run build && node scripts/start-fresh.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "oxlint . --deny-warnings",
    "lint:local": "node scripts/lint-local.mjs",
    "test": "node scripts/test-temp.mjs node_modules/vitest/vitest.mjs run",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "test:packaged": "node scripts/test-temp.mjs scripts/electron-tests.mjs --packaged",
    "test:ci": "node scripts/test-temp.mjs --require ./tests/helpers/setup.js --test scripts/packaging-build.test.mjs scripts/remote-host-artifacts.test.mjs scripts/start-hosts.test.mjs scripts/remote-host-darwin.test.mjs scripts/macos-sign.test.mjs scripts/git-safety.test.mjs scripts/ci-changes.test.mjs scripts/nightly.test.mjs scripts/nightly-feed.test.mjs scripts/mcp-probe-ci.test.mjs scripts/process-audit.test.mjs scripts/electron-shard.test.mjs scripts/rebalance-electron-shards.test.mjs scripts/electron-tests.test.mjs scripts/electron-display.test.mjs scripts/capture-session.test.mjs scripts/electron-affected.test.mjs scripts/check-local.test.mjs scripts/lint-local.test.mjs scripts/lint-fixtures.test.mjs scripts/installers.test.mjs scripts/release.test.mjs scripts/icon.test.mjs scripts/docs-check.test.mjs scripts/test-temp.test.mjs",
    "test:watch": "node scripts/test-temp.mjs node_modules/vitest/vitest.mjs",
    "test:coverage": "node scripts/test-temp.mjs node_modules/vitest/vitest.mjs run --coverage && node --require ./tests/helpers/setup.js --test scripts/tsx-coverage.test.mjs && node scripts/print-coverage-url.mjs",
    "test:electron:affected": "node scripts/test-temp.mjs scripts/electron-affected.mjs",
    "test:electron": "node scripts/test-temp.mjs scripts/electron-tests.mjs",
    "check:local": "node scripts/check-local.mjs",
    "check": "pnpm run format:check && pnpm run docs:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run test:ci",
    "prepare": "husky",
    "audit": "pnpm audit --audit-level=low",
    "test:installers": "node scripts/test-temp.mjs scripts/installer-smoke.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "lint:benchmark": "node scripts/lint-benchmark.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-base": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@electron/notarize": "3.1.2",
    "@eslint-react/eslint-plugin": "5.23.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "electron": "44.9.3",
    "electron-winstaller": "5.4.4",
    "esbuild": "0.28.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "postject": "1.0.0-alpha.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "graphql": "16.14.2",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "music-metadata": "12.1.0",
    "node-pty": "1.2.0-beta.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "strtok3": "10.3.5"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "vite": "8.3.3",
      "@electron/asar>glob": "14.0.3",
      "@electron/asar>minimatch": "11.0.3",
      "electron-installer-common>@electron/asar": "4.3.1",
      "electron-installer-common>glob": "14.0.3",
      "@typescript-eslint/typescript-estree>minimatch": "11.0.3",
      "temp>rimraf": "6.1.3",
      "rimraf>glob": "14.0.3",
      "electron-winstaller>@electron/asar": "4.3.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "patchedDependencies": {
      "electron-installer-common@0.10.4": "patches/electron-installer-common@0.10.4.patch",
      "temp@0.9.4": "patches/temp@0.9.4.patch"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "eslint"
      ]
    }
  }
}
